# ==============================================================================
# AI-Powered Employee Management System - Environment Variables
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL 8.x)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/employee_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=rootpassword

# Active Profile: set to 'mysql' for standard MySQL production, or 'h2' for standalone quick testing
SPRING_PROFILES_ACTIVE=mysql

# Seed Credentials (Development & Testing)
APP_SECURITY_ADMIN_USERNAME=admin@company.com
APP_SECURITY_ADMIN_PASSWORD=Admin@123
APP_SECURITY_USER_USERNAME=user@company.com
APP_SECURITY_USER_PASSWORD=User@123

# AI Integration Configuration (OpenAI, Gemini, or Ollama compatible)
# Options: 'openai', 'gemini', 'ollama', or 'disabled' (will use rule-based fallback)
AI_PROVIDER=openai
AI_API_KEY=your-openai-api-key-here
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# AI Fallback: If AI_API_KEY is blank or provider is unavailable,
# the system automatically switches to the built-in intelligent rule-based analytics engine.
